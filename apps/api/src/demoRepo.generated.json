    {
      "path": "package.json",
      "content": "{\n  \"name\": \"@siidekick/vulnerable-app\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"DELIBERATELY VULNERABLE demo app for Siidekick. Never deploy.\",\n  \"type\": \"commonjs\",\n  \"main\": \"server.js\",\n  \"scripts\": { \"start\": \"node server.js\", \"test\": \"node --test test/\" },\n  \"dependencies\": { \"express\": \"4.17.1\", \"lodash\": \"4.17.15\" }\n}\n"
    },
    {
      "path": "public/login.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Sign in - CampusKart</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: system-ui, -apple-system, sans-serif; background: #0b1021; color: #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; gap: 18px; }\n  .banner { position: relative; width: 920px; height: 420px; border: 5px solid #f59e0b; overflow: hidden; }\n  .decoration { position: absolute; width: 320px; height: 320px; background: #f59e0b; border-radius: 50%; animation: drift 7s ease-in-out infinite; left: 50px; top: 50px; }\n  @keyframes drift {\n    0% { left: 50px; top: 50px; }\n    20% { left: 500px; top: 120px; }\n    40% { left: 120px; top: 300px; }\n    60% { left: 560px; top: 260px; }\n    80% { left: 200px; top: 80px; }\n    100% { left: 50px; top: 50px; }\n  }\n  form { background: #1e293b; padding: 26px; border-radius: 8px; border: 1px solid #334155; width: 340px; }\n  h2 { margin-bottom: 18px; text-align: center; font-size: 22px; }\n  label { display: block; margin: 11px 0 6px; font-size: 14px; color: #cbd5e1; }\n  input { width: 100%; padding: 9px; margin-bottom: 10px; border: 1px solid #475569; border-radius: 4px; background: #0f172a; color: #e2e8f0; }\n  button { width: 100%; padding: 11px; background: #f59e0b; border: none; border-radius: 4px; color: #0b1021; font-weight: 700; cursor: pointer; font-size: 16px; }\n  button:hover { background: #d97706; }\n  #msg { margin-top: 14px; font-size: 14px; min-height: 22px; text-align: center; }\n</style>\n</head>\n<body>\n  <div class=\"banner\"><div class=\"decoration\"></div></div>\n  <form id=\"login\">\n    <h2>Sign in</h2>\n    <label for=\"email\">Campus email</label>\n    <input type=\"email\" id=\"email\" name=\"email\" required>\n    <label for=\"password\">Password</label>\n    <input type=\"password\" id=\"password\" name=\"password\" required>\n    <button type=\"submit\">Sign in</button>\n    <div id=\"msg\"></div>\n  </form>\n<script>\n(function () {\n  'use strict';\n\n  var form = document.getElementById('login');\n  var emailInput = document.getElementById('email');\n  var passwordInput = document.getElementById('password');\n  var msg = document.getElementById('msg');\n  var btn = form.querySelector('button');\n\n  function setMessage(text, kind) {\n    msg.textContent = text;\n    msg.style.color = kind === 'error' ? '#f87171' : '#4ade80';\n  }\n\n  function clearMessage() {\n    msg.textContent = '';\n  }\n\n  function isCampusEmail(value) {\n    return typeof value === 'string' && value.endsWith('@campus.edu');\n  }\n\n  function isLongEnough(value) {\n    return typeof value === 'string' && value.length >= 6;\n  }\n\n  function validateInputs(email, password) {\n    if (!email || !password) {\n      return 'Fill in both fields.';\n    }\n    if (!isCampusEmail(email)) {\n      return 'Use your campus email address.';\n    }\n    if (!isLongEnough(password)) {\n      return 'Password must be at least 6 characters.';\n    }\n    return null;\n  }\n\n  function busy() {\n    btn.disabled = true;\n    btn.textContent = 'Signing in...';\n  }\n\n  function idle() {\n    btn.disabled = false;\n    btn.textContent = 'Sign in';\n  }\n\n  async function handleSubmit(event) {\n    event.preventDefault();\n    clearMessage();\n    var email = emailInput.value.trim();\n    var password = passwordInput.value;\n    var problem = validateInputs(email, password);\n    if (problem) {\n      setMessage(problem, 'error');\n      return;\n    }\n    busy();\n    try {\n      var response = await fetch('/login', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ email: email, password: password })\n      });\n      var payload = await response.json().catch(function () { return {}; });\n      if (response.ok) {\n        setMessage('Welcome, ' + (payload.user && payload.user.name ? payload.user.name : 'there') + '!', 'ok');\n        setTimeout(function () { window.location.href = '/'; }, 1200);\n      } else {\n        setMessage('Invalid email or password.', 'error');\n      }\n    } catch (err) {\n      setMessage('Could not reach the server.', 'error');\n    } finally {\n      idle();\n    }\n  }\n\n  form.addEventListener('submit', handleSubmit);\n  emailInput.addEventListener('focus', clearMessage);\n  var STEPS = [\n    { id: 1, title: 'Welcome to CampusKart', text: 'Pick your fest merch and check out.' },\n    { id: 2, title: 'Campus email required', text: 'Sign in with your college address.' },\n    { id: 3, title: 'Browse products', text: 'Search the catalog by name.' },\n    { id: 4, title: 'Add to cart', text: 'Merge items into your cart.' },\n    { id: 5, title: 'Checkout', text: 'Pay with the campus payment provider.' },\n    { id: 6, title: 'Admin panel', text: 'Staff can view registered users.' },\n    { id: 7, title: 'Open API', text: 'Product search is open to everyone.' },\n    { id: 8, title: 'No rate limit', text: 'Login attempts are not throttled.' },\n    { id: 9, title: 'CORS enabled', text: 'Requests from any origin are allowed.' },\n    { id: 10, title: 'No security headers', text: 'Responses do not set CSP or HSTS.' },\n    { id: 11, title: 'Animated banner', text: 'A decorative element drifts across the page.' },\n    { id: 12, title: 'Login script', text: 'This page loads a long initialization script.' },\n    { id: 13, title: 'Step thirteen', text: 'Placeholder content for layout testing.' },\n    { id: 14, title: 'Step fourteen', text: 'Placeholder content for layout testing.' },\n    { id: 15, title: 'Step fifteen', text: 'Placeholder content for layout testing.' },\n    { id: 16, title: 'Step sixteen', text: 'Placeholder content for layout testing.' },\n    { id: 17, title: 'Step seventeen', text: 'Placehold